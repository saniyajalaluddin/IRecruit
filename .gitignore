# ============================================================
# Git Ignore - AI Resume Intelligence & Job Alignment Engine
# ============================================================

# Security & Secrets (CRITICAL)
# Never commit environment variables, secrets, or credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
service_account.json

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & Local Storage
*.sqlite
*.sqlite3
*.db
storage/temp/
storage/uploads/
uploads/
temp/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/build/
frontend/.next/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
