# ============================================================
# Environment Template - AI Resume Intelligence & Job Alignment Engine
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file or hardcode credentials!
# ============================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=true
APP_NAME="AI Resume Intelligence & Job Alignment Engine"
APP_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate a secure secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Configuration
# Local SQLite default for development; PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./storage/irecruit.db

# Storage & Upload Limits
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB max per file
UPLOAD_TEMP_DIR=./storage/temp

# AI Provider Configuration (OpenAI, Ollama, Mock)
# Default is mock/offline mode for safe local testing without API keys
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-model
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_EMBEDDING_MODEL=mock-embedding

# External AI Credentials (optional, leave blank for local/mock providers)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Privacy & Retention Controls
ANONYMOUS_DATA_RETENTION_HOURS=24
AUDIT_LOG_ENABLED=true
PII_REDACTION_ENABLED=true

# Rate Limiting & Abuse Prevention
RATE_LIMIT_PER_MINUTE_ANONYMOUS=10
RATE_LIMIT_PER_MINUTE_AUTHENTICATED=60
